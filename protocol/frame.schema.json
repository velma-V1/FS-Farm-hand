{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FS25 farmhand game-to-companion frame v2",
  "description": "One JSON object per line, written by mod/FarmhandObserve.lua. Field sources are recorded in adapters/EVIDENCE.md.",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/catalog"}
  ],
  "$defs": {
    "coordinate": {"type": "number", "minimum": -100000, "maximum": 100000},
    "objectId": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "nullableBool": {"type": ["boolean", "null"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 128, "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}},
    "token": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Za-z0-9_.-]"}},
    "yaw": {"type": "number", "minimum": -7, "maximum": 7},
    "jointIndex": {"type": "integer", "minimum": 1, "maximum": 32},
    "ptoNames": {"oneOf": [{"type": "null"},
                           {"type": "array", "maxItems": 16, "uniqueItems": true,
                            "items": {"type": "string", "minLength": 1, "maxLength": 64,
                                      "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}}}]},
    "jointName": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Za-z0-9_]"}},
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "mod_version", "autodrive_version"],
      "properties": {
        "event": {"const": "hello"},
        "protocol": {"const": 3},
        "mod_version": {"$ref": "#/$defs/token"},
        "build": {"$ref": "#/$defs/token"},
        "autodrive_version": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]}
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "farm_id", "category", "kinds", "name", "fill_units", "x", "z", "speed_kmh", "entered",
                   "ai_active", "has_autodrive", "ad_active", "attachment_observed",
                   "attacher_vehicle_id", "implement_ids", "heading", "ai_root", "output_joints",
                   "input_joint_poses", "forage_wagon", "motor", "pto_torque", "goto_supported",
                   "self_propelled"],
      "if": {"properties": {"attachment_observed": {"const": false}}},
      "then": {"properties": {"attacher_vehicle_id": {"type": "null"},
                              "implement_ids": {"maxItems": 0}}},
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "farm_id": {"type": "integer", "minimum": 0, "maximum": 255},
        "category": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "kinds": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "fold": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                 "required": ["time", "moving"],
                 "properties": {"time": {"type": "number", "minimum": 0, "maximum": 1}, "moving": {"type": "boolean"}}}]},
        "belts": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                  "required": ["fastened", "held"],
                  "properties": {"fastened": {"type": "boolean"},
                                 "held": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/objectId"}},
                                 "markers": {"type": "array", "maxItems": 16, "items": {
                                   "type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}}}}]},
        "belted_to": {"oneOf": [{"$ref": "#/$defs/objectId"}, {"type": "null"}]},
        "mounted_to": {"oneOf": [{"$ref": "#/$defs/objectId"}, {"type": "null"}]},
        "config_file": {"oneOf": [{"type": "string", "maxLength": 160}, {"type": "null"}]},
        "lock_positions": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false, "required": ["xml", "x", "z", "yaw", "free"],
          "properties": {"xml": {"type": "string", "maxLength": 120}, "x": {"type": "number"}, "z": {"type": "number"},
                         "yaw": {"type": "number"}, "free": {"type": "boolean"}}}}]},
        "brand": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "seeds": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/token"}}]},
        "cuts": {"oneOf": [{"type": "null"}, {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/token"}}]},
        "ai_stop": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "ai_blocked": {"type": ["boolean", "null"]},
        "work_width": {"type": ["number", "null"], "minimum": 0},
        "pipe": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                 "required": ["out", "x", "z"],
                 "properties": {"out": {"type": "boolean"}, "x": {"type": "number"}, "z": {"type": "number"}}}]},
        "size": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
                 "required": ["length", "width", "height", "length_offset"],
                 "properties": {"length": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
                                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
                                "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
                                "length_offset": {"type": "number", "minimum": -50, "maximum": 50}}}]},
        "name": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "fill_units": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["index", "fill_type", "level", "capacity", "supported", "role"],
          "properties": {
            "index": {"type": "integer", "minimum": 1, "maximum": 8},
            "fill_type": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
            "level": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
            "capacity": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000000},
            "supported": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
            "role": {"enum": ["seed", "spray", null]}}}},
        "x": {"$ref": "#/$defs/coordinate"},
        "z": {"$ref": "#/$defs/coordinate"},
        "speed_kmh": {"type": ["number", "null"], "minimum": -1000, "maximum": 1000},
        "entered": {"$ref": "#/$defs/nullableBool"},
        "ai_active": {"$ref": "#/$defs/nullableBool"},
        "has_autodrive": {"type": "boolean"},
        "ad_active": {"$ref": "#/$defs/nullableBool"},
        "attachment_observed": {"type": "boolean"},
        "attacher_vehicle_id": {"oneOf": [{"$ref": "#/$defs/objectId"}, {"type": "null"}]},
        "implement_ids": {"type": "array", "maxItems": 32, "uniqueItems": true,
                          "items": {"$ref": "#/$defs/objectId"}},
        "heading": {"oneOf": [{"$ref": "#/$defs/yaw"}, {"type": "null"}]},
        "forage_wagon": {"type": "boolean"},
        "goto_supported": {"$ref": "#/$defs/nullableBool"},
        "self_propelled": {"$ref": "#/$defs/nullableBool"},
        "motor": {"oneOf": [{"type": "null"},
                            {"type": "object", "additionalProperties": false,
                             "required": ["peak_torque", "pto_rpm_ratio"],
                             "properties": {"peak_torque": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
                                            "pto_rpm_ratio": {"oneOf": [{"type": "number", "exclusiveMinimum": 0, "maximum": 1000}, {"type": "null"}]}}}]},
        "pto_torque": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1000000}]},
        "ai_root": {"oneOf": [{"type": "null"},
                              {"type": "object", "additionalProperties": false, "required": ["x", "z", "yaw"],
                               "properties": {"x": {"$ref": "#/$defs/coordinate"},
                                              "z": {"$ref": "#/$defs/coordinate"},
                                              "yaw": {"$ref": "#/$defs/yaw"}}}]},
        "output_joints": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["index", "type", "x", "z", "free", "pto_names"],
          "properties": {"index": {"$ref": "#/$defs/jointIndex"}, "type": {"$ref": "#/$defs/jointName"},
                         "x": {"type": "number", "minimum": -50, "maximum": 50},
                         "z": {"type": "number", "minimum": -50, "maximum": 50},
                         "free": {"type": "boolean"}, "pto_names": {"$ref": "#/$defs/ptoNames"}}}},
        "input_joint_poses": {"type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["index", "type", "x", "z", "active", "pto_names"],
          "properties": {"index": {"$ref": "#/$defs/jointIndex"}, "type": {"$ref": "#/$defs/jointName"},
                         "x": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"},
                         "active": {"type": "boolean"}, "pto_names": {"$ref": "#/$defs/ptoNames"}}}}
      }
    },
    "place": {
      "description": "A named placeable the farm owns (FH Collectors.lua:628-637), at its root node.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "z"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "x": {"$ref": "#/$defs/coordinate"},
        "z": {"$ref": "#/$defs/coordinate"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "seq", "session", "farm_id", "map_id", "player", "truncated",
                   "skipped", "vehicles", "places"],
      "properties": {
        "event": {"const": "snapshot"},
        "protocol": {"const": 3},
        "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "session": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "farm_id": {"type": "integer", "minimum": 1, "maximum": 255},
        "map_id": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "player": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["x", "z"],
             "properties": {"x": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"}}}
          ]
        },
        "truncated": {"type": "boolean"},
        "skipped": {"type": "integer", "minimum": 0, "maximum": 100000},
        "vehicles": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/vehicle"}},
        "places": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/place"}},
        "field_places": {"type": "array", "maxItems": 200, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "x", "z"],
          "properties": {"id": {"type": "integer", "minimum": 1, "maximum": 100000},
                         "x": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"},
                         "farmland": {"type": "integer", "minimum": 1, "maximum": 100000},
                         "owner": {"enum": ["mine", "none", "other", "not_buyable"]},
                         "price": {"type": "number", "minimum": 0, "maximum": 1e12},
                         "area_ha": {"type": "number", "minimum": 0, "maximum": 1e6},
                         "outline": {"type": "array", "minItems": 3, "maxItems": 64, "items": {
                           "type": "array", "minItems": 2, "maxItems": 2,
                           "items": {"$ref": "#/$defs/coordinate"}}}}}},
        "fields": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/field"}},
        "contracts": {"type": "array", "maxItems": 50, "items": {
          "type": "object", "additionalProperties": false, "required": ["field", "kind", "status", "mine", "reward"],
          "properties": {"field": {"type": "integer", "minimum": 1, "maximum": 100000},
                         "kind": {"$ref": "#/$defs/token"}, "status": {"$ref": "#/$defs/token"},
                         "mine": {"type": "boolean"},
                         "fruit": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
                         "reward": {"oneOf": [{"type": "number", "minimum": -1e9, "maximum": 1e9}, {"type": "null"}]},
                         "completion": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "null"}]}}}},
        "farm": {"$ref": "#/$defs/farm"}
      }
    },
    "fraction": {"type": "number", "minimum": 0, "maximum": 1.0001},
    "storeItem": {
      "description": "A store vehicle item (mod/FarmhandObserve.lua Observe.storeItem).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "brand", "categories", "price", "mod", "width", "needed_power", "power"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "name": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "brand": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
        "categories": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/token"}},
        "price": {"type": "number", "minimum": 0, "maximum": 1000000000},
        "mod": {"type": "boolean"},
        "hitches": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 128}},
        "engines": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 128}},
        "options": {"type": "array", "maxItems": 96, "items": {"type": "object", "additionalProperties": false,
                    "required": ["kind", "type", "index", "name"],
                    "properties": {"kind": {"enum": ["config", "set"]},
                                   "type": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
                                   "index": {"type": "integer", "minimum": 1, "maximum": 1000},
                                   "name": {"type": "string", "maxLength": 128}}}},
        "width": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1000}, {"type": "null"}]},
        "needed_power": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100000}, {"type": "null"}]},
        "capacity": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1e9}, {"type": "null"}]}, "fill_types": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/token"}}, "power": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100000}, {"type": "null"}]}
      }
    },
    "catalog": {
      "description": "The store's vehicle items, sent once built and on every new link.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "items", "truncated"],
      "properties": {
        "event": {"const": "catalog"},
        "protocol": {"const": 3},
        "items": {"type": "array", "maxItems": 1500, "items": {"$ref": "#/$defs/storeItem"}},
        "truncated": {"type": "boolean"},
        "page": {"type": "integer", "minimum": 0, "maximum": 1000},
        "pages": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "coverage": {
      "description": "mod/FarmhandObserve.lua Observe.fieldCoverage: share of the field's area per GIANTS FieldGroundType name and per spray level, the field's m2, and FieldState crop samples.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ground", "spray", "total_m2", "fruit", "sampled"],
      "properties": {
        "ground": {"type": "object", "maxProperties": 64, "propertyNames": {"$ref": "#/$defs/token"},
                   "additionalProperties": {"$ref": "#/$defs/fraction"}},
        "spray": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[0-9]{1,2}$"},
                  "additionalProperties": {"$ref": "#/$defs/fraction"}},
        "total_m2": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 100000000}, {"type": "null"}]},
        "fruit": {"oneOf": [{"type": "null"},
                            {"type": "object", "maxProperties": 16, "propertyNames": {"$ref": "#/$defs/token"},
                             "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 256}}]},
        "sampled": {"type": "integer", "minimum": 0, "maximum": 256},
        "cut": {"type": "integer", "minimum": 0, "maximum": 256},
        "yield_l_m2": {"description": "The most sampled crop's GIANTS literPerSqm; null when none or unreadable.", "oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1000}]},
        "yield_max_scale": {"description": "The mission's largest harvest multiplier (1 + every factor's ratio).", "oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]},
        "windrow": {"description": "Observe.fieldWindrow: litres of each windrow fill type lying on the field; null when unreadable.",
                    "oneOf": [{"type": "null"},
                              {"type": "object", "maxProperties": 16, "propertyNames": {"$ref": "#/$defs/token"},
                               "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1000000000}}]}
      }
    },
    "field": {
      "description": "One field the farm owns (FarmlandManager:getFarmlandOwner of its farmland).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "area_ha", "x", "z", "coverage", "age_ms"],
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 100000},
        "area_ha": {"type": "number", "minimum": 0, "maximum": 100000},
        "x": {"$ref": "#/$defs/coordinate"},
        "z": {"$ref": "#/$defs/coordinate"},
        "coverage": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coverage"}]},
        "age_ms": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1000000000000}]}
      }
    },
    "farm": {
      "description": "Money and GIANTS' helper purchase settings, read only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["money", "helper_buy_seeds", "helper_buy_fertilizer", "helper_buy_fuel"],
      "properties": {
        "money": {"oneOf": [{"type": "number", "minimum": -1000000000000, "maximum": 1000000000000}, {"type": "null"}]},
        "helper_buy_seeds": {"$ref": "#/$defs/nullableBool"},
        "helper_buy_fertilizer": {"$ref": "#/$defs/nullableBool"},
        "helper_buy_fuel": {"$ref": "#/$defs/nullableBool"},
        "savegame": {"description": "The loaded savegame slot (missionInfo.savegameIndex).",
                     "oneOf": [{"type": "integer", "minimum": 1, "maximum": 99}, {"type": "null"}]},
        "savegame_dir": {"description": "The loaded save's folder (missionInfo.savegameDirectory).",
                         "oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "result": {
      "description": "One command's acceptance or terminal outcome (mod/FarmhandBridge.lua). DONE is the observed end of the operation, never on its own proof of arrival or attachment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "session", "id", "op", "status", "code"],
      "properties": {
        "event": {"const": "result"},
        "protocol": {"const": 3},
        "session": {"$ref": "#/$defs/token"},
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "op": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "status": {"enum": ["ACCEPTED", "DONE", "FAILED", "UNVERIFIED", "REJECTED"]},
        "code": {"$ref": "#/$defs/token"}
      }
    },
    "request": {
      "description": "The player asked (mod/FarmhandBridge.lua): a fixed key (action: fetch_here = AC-001 'here', stop; talk_start/talk_end while the push-to-talk key is held) or typed words (text). A wish only: the companion interprets and validates it and supplies all authority itself.",
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "session", "id"],
      "oneOf": [{"required": ["action"]}, {"required": ["text"]}, {"required": ["menu", "choice"]}],
      "properties": {
        "event": {"const": "request"},
        "protocol": {"const": 3},
        "session": {"$ref": "#/$defs/token"},
        "id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "action": {"enum": ["fetch_here", "stop", "talk_start", "talk_end", "settings"]},
        "menu": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "choice": {"type": "integer", "minimum": 0, "maximum": 9},
        "text": {"type": "string", "minLength": 1, "maxLength": 200, "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}}
      }
    }
  }
}
