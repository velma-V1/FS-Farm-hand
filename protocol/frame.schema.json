{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FS25 farmhand game-to-companion frame v1",
  "description": "One JSON object per line, written by mod/FarmhandObserve.lua. Field sources are recorded in adapters/EVIDENCE.md.",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/snapshot"}
  ],
  "$defs": {
    "coordinate": {"type": "number", "minimum": -100000, "maximum": 100000},
    "objectId": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "nullableBool": {"type": ["boolean", "null"]},
    "token": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Za-z0-9_.-]"}},
    "jointNames": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "not": {"pattern": "[^A-Za-z0-9_]"}}
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "mod_version", "autodrive_version"],
      "properties": {
        "event": {"const": "hello"},
        "protocol": {"const": 1},
        "mod_version": {"$ref": "#/$defs/token"},
        "autodrive_version": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]}
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "farm_id", "category", "x", "z", "speed_kmh", "entered",
                   "ai_active", "has_autodrive", "ad_active", "attacher_vehicle_id",
                   "implement_ids", "attacher_joints", "input_joints"],
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "farm_id": {"type": "integer", "minimum": 0, "maximum": 255},
        "category": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
        "x": {"$ref": "#/$defs/coordinate"},
        "z": {"$ref": "#/$defs/coordinate"},
        "speed_kmh": {"type": ["number", "null"], "minimum": -1000, "maximum": 1000},
        "entered": {"$ref": "#/$defs/nullableBool"},
        "ai_active": {"$ref": "#/$defs/nullableBool"},
        "has_autodrive": {"type": "boolean"},
        "ad_active": {"$ref": "#/$defs/nullableBool"},
        "attacher_vehicle_id": {"oneOf": [{"$ref": "#/$defs/objectId"}, {"type": "null"}]},
        "implement_ids": {"type": "array", "maxItems": 32, "uniqueItems": true,
                          "items": {"$ref": "#/$defs/objectId"}},
        "attacher_joints": {"$ref": "#/$defs/jointNames"},
        "input_joints": {"$ref": "#/$defs/jointNames"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "z"],
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "x": {"$ref": "#/$defs/coordinate"},
        "z": {"$ref": "#/$defs/coordinate"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "protocol", "seq", "farm_id", "player", "truncated",
                   "skipped", "vehicles", "destinations"],
      "properties": {
        "event": {"const": "snapshot"},
        "protocol": {"const": 1},
        "seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "farm_id": {"type": "integer", "minimum": 1, "maximum": 255},
        "player": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["x", "z"],
             "properties": {"x": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"}}}
          ]
        },
        "truncated": {"type": "boolean"},
        "skipped": {"type": "integer", "minimum": 0, "maximum": 100000},
        "vehicles": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/vehicle"}},
        "destinations": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/destination"}}
      }
    }
  }
}
