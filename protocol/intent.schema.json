{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farmhand executor intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "task",
    "farm_id",
    "target"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "task": {
      "enum": [
        "deliver_tractor_and_forage_wagon",
        "move_pair",
        "hitch_pair",
        "detach_pair",
        "field_work",
        "buy",
        "save_game"
      ],
      "description": "field_work: GIANTS' field-work helper works an owned field with the hitched implement that does the operation; complete only on the field's measured state; target is player_at_acceptance. deliver_tractor_and_forage_wagon: select, hitch and deliver an available pair. move_pair: move the hitched tractor and forage wagon nearest the requester. hitch_pair: select and hitch an available pair where the wagon stands, no delivery. detach_pair: unhitch the implement (of the named kind, else any) from the tractor it is hitched to nearest the requester, where it stands; target is player_at_acceptance."
    },
    "farm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "target": {
      "oneOf": [
        {
          "const": "player_at_acceptance"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_id"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_name"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field"
          ],
          "properties": {
            "type": {
              "const": "field_entrance"
            },
            "field": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "place"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        }
      ]
    },
    "field": {
      "description": "field_work: an owned field's GIANTS id, or the smallest owned field.",
      "oneOf": [{"type": "integer", "minimum": 1, "maximum": 100000}, {"const": "smallest"}]
    },
    "want": {
      "description": "buy: what to buy. kind: plow (a store plow our tractors can pull), truck or trailer (by the name the player gave); size large: the widest that fits.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["plow", "truck", "trailer"]},
        "size": {"enum": ["large"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9 -]+$"}
      }
    },
    "tractor_name": {"description": "fetch_pair, hitch_pair: the towing vehicle must have all these words in its name ('with the gmc').", "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9][a-z0-9 -]*$"},
    "implement_name": {"description": "fetch_pair, hitch_pair: the implement must have all these words in its name ('the gooseneck').", "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9][a-z0-9 -]*$"},
    "area_m2": {
      "description": "field_work: work only this much of the field (a bounded test area, m2); the whole field when absent.",
      "type": "number", "minimum": 50, "maximum": 20000
    },
    "operation": {
      "description": "field_work: what to do to the field (companion/field.py OPERATIONS).",
      "enum": ["plow", "cultivate", "sow", "fertilize"]
    },
    "implement": {
      "description": "The implement to hitch or unhitch (a GIANTS specialization kind; default forage_wagon to hitch, any to unhitch). Only for deliver_tractor_and_forage_wagon, hitch_pair, detach_pair.",
      "enum": [
        "forage_wagon",
        "plow",
        "cultivator",
        "sowing_machine",
        "sprayer",
        "mower",
        "tedder",
        "windrower",
        "baler",
        "bale_wrapper",
        "trailer",
        "roller",
        "weeder",
        "mulcher",
        "stone_picker",
        "manure_barrel",
        "mixer_wagon",
        "water_trailer",
        "salt_spreader",
        "tree_planter"
      ]
    }
  },
  "description": "Move farm equipment to a destination. Every target is travel only; no target starts fieldwork. A place is an AutoDrive marker of exactly that name or the one owned placeable whose name contains its words. Arbitrary coordinates and vehicle IDs are unsupported.",
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "not": {
              "enum": [
                "deliver_tractor_and_forage_wagon",
                "hitch_pair",
                "detach_pair",
                "field_work"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "implement"
          ]
        }
      }
    },
    {
      "if": {"properties": {"task": {"const": "buy"}}},
      "then": {"required": ["want"], "properties": {"target": {"const": "player_at_acceptance"}}},
      "else": {"not": {"required": ["want"]}}
    },
    {
      "if": {"properties": {"task": {"const": "field_work"}}},
      "then": {"required": ["field", "operation"], "properties": {"target": {"const": "player_at_acceptance"}}},
      "else": {"not": {"anyOf": [{"required": ["field"]}, {"required": ["operation"]}, {"required": ["area_m2"]}]}}
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "detach_pair"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "const": "player_at_acceptance"
          }
        }
      }
    }
  ]
}
