{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farmhand executor intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "task",
    "farm_id",
    "target"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "task": {
      "enum": [
        "deliver_tractor_and_forage_wagon",
        "move_pair",
        "hitch_pair",
        "detach_pair"
      ],
      "description": "deliver_tractor_and_forage_wagon: select, hitch and deliver an available pair. move_pair: move the hitched tractor and forage wagon nearest the requester. hitch_pair: select and hitch an available pair where the wagon stands, no delivery. detach_pair: unhitch the implement (of the named kind, else any) from the tractor it is hitched to nearest the requester, where it stands; target is player_at_acceptance."
    },
    "farm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "target": {
      "oneOf": [
        {
          "const": "player_at_acceptance"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_id"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_name"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field"
          ],
          "properties": {
            "type": {
              "const": "field_entrance"
            },
            "field": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "place"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        }
      ]
    },
    "implement": {
      "description": "The implement to hitch or unhitch (a GIANTS specialization kind; default forage_wagon to hitch, any to unhitch). Only for deliver_tractor_and_forage_wagon, hitch_pair, detach_pair.",
      "enum": [
        "forage_wagon",
        "plow",
        "cultivator",
        "sowing_machine",
        "sprayer",
        "mower",
        "tedder",
        "windrower",
        "baler",
        "bale_wrapper",
        "trailer",
        "roller",
        "weeder",
        "mulcher",
        "stone_picker",
        "manure_barrel",
        "mixer_wagon",
        "water_trailer",
        "salt_spreader",
        "tree_planter"
      ]
    }
  },
  "description": "Move farm equipment to a destination. Every target is travel only; no target starts fieldwork. A place is an AutoDrive marker of exactly that name or the one owned placeable whose name contains its words. Arbitrary coordinates and vehicle IDs are unsupported.",
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "not": {
              "enum": [
                "deliver_tractor_and_forage_wagon",
                "hitch_pair",
                "detach_pair"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "implement"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "const": "detach_pair"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "const": "player_at_acceptance"
          }
        }
      }
    }
  ]
}
