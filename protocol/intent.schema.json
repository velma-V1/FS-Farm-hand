{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AC-001 farmhand intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "task",
    "farm_id",
    "target"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "task": {
      "const": "deliver_tractor_and_forage_wagon"
    },
    "farm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "target": {
      "const": "player_at_acceptance"
    }
  }
}
