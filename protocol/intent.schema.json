{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farmhand executor intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "task",
    "farm_id",
    "target"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "task": {
      "enum": [
        "deliver_tractor_and_forage_wagon",
        "move_pair"
      ],
      "description": "deliver_tractor_and_forage_wagon: select, hitch and deliver an available pair. move_pair: move the hitched tractor and forage wagon nearest the requester."
    },
    "farm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "target": {
      "oneOf": [
        {
          "const": "player_at_acceptance"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_id"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "marker_name"
          ],
          "properties": {
            "type": {
              "const": "autodrive_marker"
            },
            "marker_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field"
          ],
          "properties": {
            "type": {
              "const": "field_entrance"
            },
            "field": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "place"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Move farm equipment to a destination. Every target is travel only; no target starts fieldwork. A place is an AutoDrive marker of exactly that name or the one owned placeable whose name contains its words. Arbitrary coordinates and vehicle IDs are unsupported."
}
