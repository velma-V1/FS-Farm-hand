<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- FS25_Farmhand: the AC-001 game-side bridge plus the diagnostic hitch probe (mod/README.md).
     descVersion as AutoDrive 3.0.1.4 and Manual Attach 1.1.1.0. No icon: FS25
     loads a folder mod without one (Farmhand Companion modDesc.xml comment),
     and this build is never shipped as a ZIP. -->
<modDesc descVersion="113">
    <author>FS-Farm-hand</author>
    <version>0.1.0.0</version>
    <title>
        <en>Farmhand AC-001 (development)</en>
    </title>
    <description>
        <en>Press Left Alt + J on foot: the local Farmhand companion fetches an owned tractor and forage wagon, hitches them and brings them to you. The fhHitch* console commands are diagnostics. Nothing moves on load.</en>
    </description>
    <!-- Actions, bindings and texts as AutoDrive 3.0.1.4 modDesc.xml 51-119. -->
    <l10n filenamePrefix="translations/translation" />
    <actions>
        <action name="FARMHAND_FETCH_HERE"/>
    </actions>
    <inputBinding>
        <actionBinding action="FARMHAND_FETCH_HERE">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_j" />
        </actionBinding>
    </inputBinding>
    <multiplayer supported="false"/>
    <extraSourceFiles>
        <sourceFile filename="FarmhandObserve.lua"/>
        <sourceFile filename="FarmhandHitch.lua"/>
        <sourceFile filename="FarmhandBridge.lua"/>
        <sourceFile filename="FarmhandProbe.lua"/>
    </extraSourceFiles>
</modDesc>
